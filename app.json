{
  "expo": {
    "name": "Talkeven",
    "slug": "duodialect",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "duodialect",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/brand/icon-dark.png",
        "tinted": "./assets/brand/icon-tinted.png"
      },
      "bundleIdentifier": "com.lachlanirving.duodialect",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16a39f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lachlanirving.duodialect",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#16a39f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Talkeven uses your photo library so you can add profile photos that help language partners recognise you.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16a39f",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0f2f3d"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89e0b3af-62c9-42e6-b47f-753f15a34823"
      }
    },
    "owner": "lachie_irving"
  }
}
