{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "sdk-54"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "sdk-54"
      }
    },
    "testflight": {
      "extends": "production",
      "environment": "preview",
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6816316060",
        "appleTeamId": "MAYKX6UAZK"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6816316060",
        "appleTeamId": "MAYKX6UAZK"
      }
    }
  }
}
