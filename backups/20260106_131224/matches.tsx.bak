import { useEffect, useState } from "react";
import { View, Text, ActivityIndicator, ScrollView, Pressable } from "react-native";
import { router } from "expo-router";
import { auth, db } from "../../src/lib/firebase";
import { chatIdFor, ensureChat } from "../../src/lib/chat";
import { collection, doc, getDoc, getDocs } from "firebase/firestore";

type UserLang = { lang: string; level: string };
type UserProfile = { uid: string; name?: string; bio?: string; speaks: UserLang[]; learns: UserLang[] };

type ChatMeta = { lastText?: string; lastAt?: any };
type MatchRow = { otherUid: string; chatId: string; profile?: UserProfile; chat?: ChatMeta };

function relTime(ts: any) {
  if (!ts) return "";
  const ms = ts?.toMillis ? ts.toMillis() : (ts?.toDate ? ts.toDate().getTime() : new Date(ts).getTime());
  const diff = Date.now() - ms;

  if (diff < 15_000) return "now";
  const s = Math.floor(diff / 1000);
  if (s < 60) return `${s}s`;
  const m = Math.floor(s / 60);
  if (m < 60) return `${m}m`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h`;
  const d = Math.floor(h / 24);
  if (d < 7) return `${d}d`;
  const w = Math.floor(d / 7);
  if (w < 8) return `${w}w`;
  const mo = Math.floor(d / 30);
  return `${mo}mo`;
}

export default function Matches() {
  const [loading, setLoading] = useState(true);
  const [rows, setRows] = useState<MatchRow[]>([]);

  useEffect(() => {
    async function load() {
      const user = auth.currentUser;
      if (!user) return;

      setLoading(true);
      try {
        const ms = await getDocs(collection(db, "matches", user.uid, "with"));

        const out: MatchRow[] = [];
        for (const d of ms.docs) {
          const data = d.data() as any;
          const otherUid = data.with || d.id;
          const chatId = data.chatId || chatIdFor(user.uid, otherUid);

          const profSnap = await getDoc(doc(db, "users", otherUid));
          const profile = profSnap.exists() ? (profSnap.data() as UserProfile) : undefined;

          const chatSnap = await getDoc(doc(db, "chats", chatId));
          const chat = chatSnap.exists() ? (chatSnap.data() as ChatMeta) : undefined;

          out.push({ otherUid, chatId, profile, chat });
        }

        out.sort((a, b) => {
          const atA = a.chat?.lastAt?.toMillis?.() ?? 0;
          const atB = b.chat?.lastAt?.toMillis?.() ?? 0;
          return atB - atA;
        });

        setRows(out);
      } finally {
        setLoading(false);
      }
    }

    load();
  }, []);

  async function openChat(chatId: string, otherUid: string) {
    const me = auth.currentUser?.uid;
    if (!me) return;
    await ensureChat(me, otherUid);
    router.push(`/chat/${chatId}?otherUid=${otherUid}`);
  }

  if (loading) {
    return <View style={{ flex: 1, justifyContent: "center", alignItems: "center" }}><ActivityIndicator /></View>;
  }

  return (
    <ScrollView contentContainerStyle={{ padding: 24, gap: 12 }}>
      <Text style={{ fontSize: 22, fontWeight: "900" }}>Matches</Text>

      {rows.length === 0 ? (
        <Text style={{ opacity: 0.7 }}>No matches yet. Go create linguistic chaos in Swipe.</Text>
      ) : (
        rows.map(r => {
          const name = r.profile?.name?.trim() ? r.profile?.name : "Anonymous";
          const bio = r.profile?.bio?.trim() ? r.profile?.bio : "";
          const lastText = r.chat?.lastText?.trim() ? r.chat?.lastText : "Tap to chat";
          const when = relTime(r.chat?.lastAt);

          return (
            <Pressable
              key={r.otherUid}
              onPress={() => openChat(r.chatId, r.otherUid)}
              style={{ borderWidth: 1, borderColor: "#eee", borderRadius: 16, padding: 14, gap: 6 }}
            >
              <View style={{ flexDirection: "row", justifyContent: "space-between", alignItems: "center" }}>
                <Text style={{ fontWeight: "900", fontSize: 16 }}>{name}</Text>
                <Text style={{ opacity: 0.6, fontSize: 12 }}>{when}</Text>
              </View>

              {bio ? <Text style={{ opacity: 0.7 }}>{bio}</Text> : null}

              <Text style={{ opacity: 0.9 }}>{lastText}</Text>

              <Text style={{ opacity: 0.75, fontSize: 12 }}>
                Speaks: {(r.profile?.speaks || []).map(x => x.lang).join(", ")} • Learns: {(r.profile?.learns || []).map(x => x.lang).join(", ")}
              </Text>
            </Pressable>
          );
        })
      )}
    </ScrollView>
  );
}
