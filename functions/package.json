{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --project demo-duodialect --config ../firebase.json --only auth,firestore,functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --project demo-duodialect --config ../firebase.json --only auth,firestore,functions \"node --test --test-concurrency=1 test/*.test.js\""
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "expo-server-sdk": "^4.0.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
